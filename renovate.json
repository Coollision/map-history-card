{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "MapLibre GL JS version loaded from jsDelivr",
      "managerFilePatterns": ["/^map-history-card\\.js$/"],
      "matchStrings": ["const MAPLIBRE_VERSION = \"(?<currentValue>[^\"]+)\";"],
      "datasourceTemplate": "npm",
      "depNameTemplate": "maplibre-gl"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["maplibre-gl"],
      "allowedVersions": "<6",
      "commitMessagePrefix": "fix(deps):",
      "automerge": false
    }
  ]
}
